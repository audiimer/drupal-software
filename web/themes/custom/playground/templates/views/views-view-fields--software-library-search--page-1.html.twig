{#
  Software Library Search - Fields (card) template
#}

{% set entity = row._entity %}

{% set cat_values = [] %}
{% for item in entity.field_category %}
  {% set cat_values = cat_values|merge([item.entity.label|lower]) %}
{% endfor %}

{% set os_list = [] %}
{% for item in entity.field_available_for %}
  {% set os_list = os_list|merge([item.value|lower|replace({'_': ' '})]) %}
{% endfor %}

{% set access_list = [] %}
{% for item in entity.field_how_to_access %}
  {% set access_list = access_list|merge([item.entity.label|lower]) %}
{% endfor %}

{% set access_type = entity.field_access_type.value %}

<div class="software-card"
     data-category="{{ cat_values|join(',') }}"
     data-os="{{ os_list|join(',') }}"
     data-access="{{ access_list|join(',') }}"
     data-access-type="{{ access_type }}">

  <div class="software-card__logo">
    {{ fields.field_software_logo_image.content }}
  </div>

  <div class="software-card__title">
    <a href="{{ path('entity.node.canonical', {'node': entity.id}) }}"
       class="software-card__link"
       aria-label="{{ entity.label }}">
      {{ entity.label }}
    </a>
  </div>

  {# Access Type indicator pill #}
  {% if access_type %}
    <div class="software-card__access-tag software-card__access-tag--{{ access_type }}">
      {{ access_type|capitalize }}
    </div>
  {% endif %}

  {# Price (above button) #}
  {% if software_price %}
    <div class="software-card__price">{{ software_price }}</div>
  {% endif %}

  {# Real Commerce Add to Cart form for Download/Chargeback types #}
  {% if access_type == 'download' or access_type == 'chargeback' %}
    {% if add_to_cart_form %}
      <div class="software-card__cta-wrap">
        {{ add_to_cart_form }}
      </div>
    {% else %}
      <button class="software-card__cta software-card__cta--disabled"
              type="button"
              disabled
              title="Not yet available for purchase">
        <span class="software-card__cta-icon" aria-hidden="true">+</span>
        Coming soon
      </button>
    {% endif %}
  {% endif %}

</div>
