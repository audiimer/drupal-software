<?php
/**
 * @file
 * Theme functions.
 */

// Catalog preprocessing (price, request link, view library/roles)
// has been extracted into lts_software's CatalogViewsPreprocessHooks
// (OOP #[Hook] attributes) so this theme has no functional dependency on
// the software library. See lts_software/src/Hook/CatalogViewsPreprocessHooks.php.

// Include all files from the includes directory.
$includes_path = __DIR__ . '/includes/*.theme';
foreach (glob($includes_path) as $file) {
  require_once __DIR__ . '/includes/' . basename($file);
}
