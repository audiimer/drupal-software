<?php

/**
 * @file
 * Primary module hooks for Webform Workflows Element module.
 */

use Drupal\Core\Access\AccessResultInterface;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Render\BubbleableMetadata;
use Drupal\Core\Session\AccountInterface;
use Drupal\webform\WebformInterface;
use Drupal\webform\WebformSubmissionInterface;
use Drupal\webform_workflows_element\Hook\EntityTypeHooks;
use Drupal\webform_workflows_element\Hook\FormHooks;
use Drupal\webform_workflows_element\Hook\ResultsFilterHooks;
use Drupal\webform_workflows_element\Hook\ThemeHooks;
use Drupal\webform_workflows_element\Hook\TokenHooks;
use Drupal\webform_workflows_element\Hook\WebformWorkflowsElementHooks;

/* ************************************************************************** */
// Hook implementations (LegacyHook stubs).
/* ************************************************************************** */

/**
 * Implements hook_ENTITY_TYPE_view().
 *
 * @throws \Drupal\Core\Entity\EntityMalformedException
 */
#[LegacyHook]
function webform_workflows_element_webform_submission_view(array &$build, EntityInterface $entity, EntityViewDisplayInterface $display, $view_mode) {
  \Drupal::service(WebformWorkflowsElementHooks::class)->webformSubmissionView($build, $entity, $display, $view_mode);
}

/**
 * Implements hook_webform_element_access().
 */
#[LegacyHook]
function webform_workflows_element_webform_element_access($operation, array &$element, ?AccountInterface $account = NULL, array $context = []) {
  return \Drupal::service(WebformWorkflowsElementHooks::class)->webformElementAccess($operation, $element, $account, $context);
}

/**
 * Implements hook_form_alter().
 */
#[LegacyHook]
function webform_workflows_element_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(FormHooks::class)->formAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_webform_element_ELEMENT_TYPE_alter().
 */
#[LegacyHook]
function webform_workflows_element_webform_element_webform_workflows_element_alter(array &$element, FormStateInterface $form_state, array $context) {
  \Drupal::service(FormHooks::class)->webformElementAlter($element, $form_state, $context);
}

/**
 * Implements hook_webform_submission_form_alter().
 */
#[LegacyHook]
function webform_workflows_element_webform_submission_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(FormHooks::class)->webformSubmissionFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_webform_submission_presave().
 */
#[LegacyHook]
function webform_workflows_element_webform_submission_presave(WebformSubmissionInterface $webform_submission) {
  \Drupal::service(WebformWorkflowsElementHooks::class)->webformSubmissionPresave($webform_submission);
}

/**
 * Implements hook_webform_submission_access().
 */
#[LegacyHook]
function webform_workflows_element_webform_submission_access(WebformSubmissionInterface $webform_submission, $operation, AccountInterface $account): AccessResultInterface {
  return \Drupal::service(WebformWorkflowsElementHooks::class)->webformSubmissionAccess($webform_submission, $operation, $account);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function webform_workflows_element_theme(): array {
  return \Drupal::service(ThemeHooks::class)->theme();
}

/**
 * Implements hook_entity_operation_alter().
 *
 * @throws \Exception
 */
#[LegacyHook]
function webform_workflows_element_entity_operation_alter(array &$operations, EntityInterface $entity) {
  \Drupal::service(WebformWorkflowsElementHooks::class)->entityOperationAlter($operations, $entity);
}

/**
 * Implements hook_entity_type_alter().
 */
#[LegacyHook]
function webform_workflows_element_entity_type_alter(array &$entity_types) {
  \Drupal::service(EntityTypeHooks::class)->entityTypeAlter($entity_types);
}

/**
 * Implements hook_form_FORM_ID_alter().
 */
#[LegacyHook]
function webform_workflows_element_form_webform_submission_filter_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  \Drupal::service(ResultsFilterHooks::class)->formWebformSubmissionFilterFormAlter($form, $form_state, $form_id);
}

/**
 * Implements hook_webform_better_results_query_alter().
 */
#[LegacyHook]
function webform_workflows_element_webform_better_results_query_alter(&$data, $query_strings, $webform) {
  \Drupal::service(ResultsFilterHooks::class)->webformBetterResultsQueryAlter($data, $query_strings, $webform);
}

/**
 * Implements hook_webform_better_results_form_alter().
 */
#[LegacyHook]
function webform_workflows_element_webform_better_results_form_alter(&$data) {
  \Drupal::service(ResultsFilterHooks::class)->webformBetterResultsFormAlter($data);
}

/**
 * Implements hook_webform_better_results_submit_alter().
 */
#[LegacyHook]
function webform_workflows_element_webform_better_results_submit_alter(array &$data) {
  \Drupal::service(ResultsFilterHooks::class)->webformBetterResultsSubmitAlter($data);
}

/**
 * Implements hook_token_info().
 */
#[LegacyHook]
function webform_workflows_element_token_info(): array {
  return \Drupal::service(TokenHooks::class)->tokenInfo();
}

/**
 * Implements hook_tokens().
 */
#[LegacyHook]
function webform_workflows_element_tokens($type, $tokens, array $data, array $options, BubbleableMetadata $bubbleable_metadata): array {
  return \Drupal::service(TokenHooks::class)->tokens($type, $tokens, $data, $options, $bubbleable_metadata);
}

/* ************************************************************************** */
// Template preprocess.
/* ************************************************************************** */

/**
 * Prepares variables for webform_workflows_element_value template.
 *
 * Delegates to ThemeHooks for the actual logic. This function
 * cannot be removed — it is discovered by naming convention
 * by the theme system.
 *
 * @param array $variables
 *   Variables from theme, by reference.
 *
 * @see webform-workflows-element-value.html.twig
 */
function template_preprocess_webform_workflows_element_value(array &$variables) {
  \Drupal::service(ThemeHooks::class)->preprocessWebformWorkflowsElementValue($variables);
}

/* ************************************************************************** */
// Form callback stubs.
/* ************************************************************************** */

/**
 * After-build callback for workflow element form.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   \Drupal\webform_workflows_element\Hook\FormHooks::elementFormAfterBuild()
 *   instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_element_form_after_build($form, &$form_state) {
  return FormHooks::elementFormAfterBuild($form, $form_state);
}

/**
 * Submit handler: reassign submissions on workflow state deletion.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   \Drupal\webform_workflows_element\Hook\FormHooks::reassignSubmissionStatesOnDeleteSubmit()
 *   instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_add_reassign_submission_states_on_delete_submit($form, $form_state) {
  FormHooks::reassignSubmissionStatesOnDeleteSubmit($form, $form_state);
}

/**
 * Submit handler for the submission filter form.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   \Drupal\webform_workflows_element\Hook\ResultsFilterHooks::filterFormSubmit()
 *   instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_webform_submission_filter_form_submit(array $form, FormStateInterface $form_state) {
  ResultsFilterHooks::filterFormSubmit($form, $form_state);
}

/* ************************************************************************** */
// Helper functions.
/* ************************************************************************** */

/**
 * Get workflow elements from form.
 *
 * @param \Drupal\webform\WebformInterface $webform
 *   The webform object.
 * @param \Drupal\Core\Session\AccountInterface $account
 *   The user account.
 *
 * @return array
 *   The array of available elements.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getWorkflowElementsForWebform() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_available_elements(WebformInterface $webform, AccountInterface $account): array {
  return \Drupal::service('webform_workflows_element.manager')
    ->getAccessibleWorkflowElements($account, $webform);
}

/**
 * Determine whether we are showing a minimal workflow edit form.
 *
 * @param \Drupal\webform\WebformSubmissionInterface $webform_submission
 *   The webform submission.
 *
 * @return bool
 *   Whether to show the workflow edit form on the current page.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::shouldShowWorkflowEditForm() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_show_workflow_edit_form(WebformSubmissionInterface $webform_submission): bool {
  return \Drupal::service('webform_workflows_element.manager')
    ->shouldShowWorkflowEditForm($webform_submission);
}

/**
 * Return true if transition is enabled.
 *
 * This does not check access, just that the webform allows the transition at
 * all.
 *
 * @param array $element
 *   The element.
 * @param string $transition_id
 *   The transition id.
 *
 * @return bool
 *   True if transition is enable.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::isTransitionEnabled() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_check_transition_enabled(array $element, string $transition_id): bool {
  return \Drupal::service('webform_workflows_element.manager')
    ->isTransitionEnabled($element, $transition_id);
}

/**
 * Get webform access operations.
 *
 * @param mixed $webform
 *   The webform.
 *
 * @return array
 *   Array of access operation IDs.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getWebformAccessOperations()
 *   instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_webform_access_operations($webform) {
  return \Drupal::service('webform_workflows_element.manager')
    ->getWebformAccessOperations($webform);
}

/* ************************************************************************** */
// Log functions (merged from webform_workflows_element.logs.inc).
/* ************************************************************************** */

/**
 * Determine whether to show workflow log on page.
 *
 * @param string $operation
 *   The operation.
 * @param \Drupal\webform\WebformSubmissionInterface $webform_submission
 *   The webform submission.
 *
 * @return bool
 *   True if authorized.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::shouldShowWorkflowLog() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_check_show_log(string $operation, WebformSubmissionInterface $webform_submission): bool {
  return \Drupal::service('webform_workflows_element.manager')
    ->shouldShowWorkflowLog($operation, $webform_submission);
}

/**
 * Get a rendered log table of workflow events for a submission.
 *
 * @param \Drupal\webform\WebformSubmissionInterface $webform_submission
 *   The webform submission.
 *
 * @return array
 *   Log render array.
 *
 * @throws \Drupal\Core\Entity\EntityMalformedException
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getRenderedWorkflowLog() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_rendered_log(WebformSubmissionInterface $webform_submission): ?array {
  return \Drupal::service('webform_workflows_element.manager')
    ->getRenderedWorkflowLog($webform_submission);
}

/* ************************************************************************** */
// Color functions (merged from webform_workflows_element.colors.inc).
/* ************************************************************************** */

/**
 * Get options for select dropdown of colors.
 *
 * We store the name as that's what the user saw to choose;
 * the class may change but "red" should stay meaning "red".
 *
 * @return array|null
 *   Array of names also keyed by name.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getColorOptions() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_color_options(): ?array {
  return \Drupal::service('webform_workflows_element.manager')
    ->getColorOptions();
}

/**
 * Load available color classes for webforms.
 *
 * @return array|null
 *   Array of classes keyed by name
 *
 * @see WebformAdminConfigWorkflowsForm
 *
 * @see webform_workflows_element.settings.schema.yml
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getColorOptionValues() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_color_options_values(): ?array {
  return \Drupal::service('webform_workflows_element.manager')
    ->getColorOptionValues();
}

/**
 * Get colors for states.
 *
 * @param array $states
 *   Array of workflow states.
 * @param mixed $workflowElement
 *   The workflow element.
 *
 * @return array
 *   Array of CSS classes keyed by state ID and label.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getColorsForStates() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_colors_for_states(array $states, $workflowElement): array {
  return \Drupal::service('webform_workflows_element.manager')
    ->getColorsForStates($states, $workflowElement);
}

/**
 * Return CSS class for a state in an element.
 *
 * @param mixed $element
 *   The element.
 * @param mixed $state_id
 *   The state id.
 *
 * @return string
 *   CSS class. Make sure it is always applied with the additional 'with-color'
 *   class.
 *
 * @deprecated in webform_workflows_element:2.1.0 and is removed from
 *   webform_workflows_element:3.0.0. Use
 *   WebformWorkflowsManager::getColorClassForState() instead.
 *
 * @see https://www.drupal.org/project/webform_workflows_element/issues/3576232
 */
function webform_workflows_element_get_color_class_for_state_from_element($element, $state_id): ?string {
  return \Drupal::service('webform_workflows_element.manager')
    ->getColorClassForState($element, $state_id);
}
