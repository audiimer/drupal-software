<?php

/**
 * @file
 * Hook implementations for the webform_workflows_element_views module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\webform_workflows_element_views\Hook\ViewsHooks;

/**
 * Implements hook_views_data().
 */
#[LegacyHook]
function webform_workflows_element_views_views_data(): array {
  return \Drupal::service(ViewsHooks::class)->viewsData();
}
