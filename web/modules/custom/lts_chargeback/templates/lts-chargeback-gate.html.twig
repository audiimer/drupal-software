{#
/**
 * @file
 * Chargeback approval gate — user-facing order view.
 *
 * Variables:
 * - gate_state: 'pending_review' | 'approved' | 'denied'
 * - message: status message string
 * - product_label: software product name (from the order item)
 * - instructions_link: render array for the instructions link (approved only)
 * - reason: denial reason string (denied only)
 */
#}
{{ attach_library('lts_chargeback/chargeback_gate') }}
<div class="chargeback-gate chargeback-gate--{{ gate_state }}">
  <div class="chargeback-gate__header">
    <p class="chargeback-gate__title">{{ product_label ?: 'Software request' }}</p>
    {% if gate_state == 'pending_review' %}
      <span class="chargeback-gate__badge">Pending review</span>
    {% elseif gate_state == 'approved' %}
      <span class="chargeback-gate__badge">Approved</span>
    {% elseif gate_state == 'denied' %}
      <span class="chargeback-gate__badge">Denied</span>
    {% endif %}
  </div>
  <div class="chargeback-gate__body">
    <div class="chargeback-gate__notice">
      {% if gate_state == 'pending_review' %}
        <i class="ti ti-clock chargeback-gate__icon" aria-hidden="true"></i>
        <p class="chargeback-gate__message">{{ message }}</p>
      {% elseif gate_state == 'approved' %}
        <i class="ti ti-circle-check chargeback-gate__icon" aria-hidden="true"></i>
        <p class="chargeback-gate__message">{{ message }}</p>
      {% elseif gate_state == 'denied' %}
        <i class="ti ti-alert-circle chargeback-gate__icon" aria-hidden="true"></i>
        <div>
          <p class="chargeback-gate__message">{{ message }}</p>
          {% if reason %}
            <p class="chargeback-gate__reason">{{ reason }}</p>
          {% endif %}
        </div>
      {% endif %}
    </div>
    {% if gate_state == 'approved' and instructions_link %}
      <a href="{{ instructions_link['#url'] }}" class="chargeback-gate__instructions-link" target="_blank" rel="noopener noreferrer">
        <i class="ti ti-external-link" aria-hidden="true"></i>
        {{ instructions_link['#title'] }}
      </a>
    {% endif %}
  </div>
</div>
