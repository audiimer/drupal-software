{#
/**
 * @file
 * Download reveal — shown on completed download orders.
 *
 * Variables:
 * - product_label: software product name
 * - rows: array of {label, value} license detail rows
 * - instructions_link: {url, title} or null
 */
#}
{{ attach_library('lts_chargeback/chargeback_gate') }}
<div class="lts-download-reveal">
  <div class="chargeback-gate__header">
    <p class="chargeback-gate__title">{{ product_label }}</p>
    <span class="chargeback-gate__badge lts-download-reveal__badge">Ready to download</span>
  </div>
  <div class="chargeback-gate__body">
    <div class="lts-download-reveal__notice">
      <i class="ti ti-circle-check lts-download-reveal__icon" aria-hidden="true"></i>
      <p class="lts-download-reveal__message">Your software is ready. Use the details below to activate your license.</p>
    </div>
    {% if rows %}
      <table class="lts-download-reveal__table">
        {% for row in rows %}
          <tr>
            <td class="lts-download-reveal__label">{{ row.label }}</td>
            <td class="lts-download-reveal__value">{{ row.value }}</td>
          </tr>
        {% endfor %}
      </table>
    {% endif %}
    {% if instructions_link %}
      <a href="{{ instructions_link.url }}" class="chargeback-gate__instructions-link" target="_blank" rel="noopener noreferrer">
        <i class="ti ti-external-link" aria-hidden="true"></i>
        {{ instructions_link.title }}
      </a>
    {% endif %}
  </div>
</div>
