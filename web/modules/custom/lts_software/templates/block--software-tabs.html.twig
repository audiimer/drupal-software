{#
/**
 * @file
 * Template for the Software Tabs block.
 *
 * Renders Description / Terms of Use / System Specs as Bootstrap 5 nav-tabs.
 * Tabs are passed in via the SoftwareTabsBlock plugin; empty fields are
 * omitted before reaching this template.
 *
 * Available variables:
 *   - tabs: array of tabs, each containing:
 *     - id: machine name (used for tab/pane linking)
 *     - label: human-readable label
 *     - type: 'html' or 'pdf'
 *     - content: render array (for html type)
 *     - file_url: URL string (for pdf type)
 *     - file_name: original filename (for pdf type)
 *     - active: TRUE on the first tab
 */
#}
<div class="software-tabs">
  <ul class="nav nav-tabs" role="tablist">
    {% for tab in tabs %}
      <li class="nav-item" role="presentation">
        <button
          class="nav-link {{ tab.active ? 'active' : '' }}"
          id="tab-{{ tab.id }}"
          data-bs-toggle="tab"
          data-bs-target="#pane-{{ tab.id }}"
          type="button"
          role="tab"
          aria-controls="pane-{{ tab.id }}"
          aria-selected="{{ tab.active ? 'true' : 'false' }}">
          {{ tab.label }}
        </button>
      </li>
    {% endfor %}
  </ul>

  <div class="tab-content">
    {% for tab in tabs %}
      <div
        class="tab-pane fade {{ tab.active ? 'show active' : '' }}"
        id="pane-{{ tab.id }}"
        role="tabpanel"
        aria-labelledby="tab-{{ tab.id }}">
        {% if tab.type == 'pdf' %}
          <div class="software-tabs__pdf-embed">
            <iframe
              src="{{ tab.file_url }}"
              title="{{ tab.label }}"
              width="100%"
              height="600"
              loading="lazy">
            </iframe>
            <p class="software-tabs__pdf-fallback">
              {{ 'Can\'t view the PDF?'|t }}
              <a href="{{ tab.file_url }}" target="_blank" rel="noopener">{{ 'Download'|t }} {{ tab.file_name }}</a>
            </p>
          </div>
        {% else %}
          {{ tab.content }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>