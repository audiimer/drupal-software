{#
  Software Library Search - Fields (card) template

  card_data_category, card_data_os, card_access_type, software_price,
  installer_modal, request_link and request_unavailable are pre-computed in PHP
  (CatalogViewsPreprocessHooks) — no entity field traversal in Twig.
#}
{% set entity = row._entity %}
<div class="software-card"
     data-category="{{ card_data_category }}"
     data-os="{{ card_data_os }}"
     data-access="{{ card_access_type }}">
  <div class="software-card__logo">
    {{ fields.field_software_logo_image.content }}
  </div>
  <div class="software-card__title">
    <a href="{{ path('entity.node.canonical', {'node': entity.id}) }}"
       class="software-card__link"
       aria-label="{{ entity.label }}">
      {{ entity.label }}
    </a>
  </div>
  {# Access Type indicator pill #}
  {% if card_access_type %}
    <div class="software-card__access-tag software-card__access-tag--{{ card_access_type }}">
      {{ card_access_type|capitalize }}
    </div>
  {% endif %}
  {# Price (above button) #}
  {% if software_price %}
    <div class="software-card__price">{{ software_price }}</div>
  {% endif %}
  {# Download: renders the same installer modal as the detail page
     (built by the shared lts_download.installer_entries_builder
     service via CatalogViewsPreprocessHooks). #}
  {% if card_access_type == 'download' %}
    <div class="software-card__cta-wrap">
      {{ installer_modal }}
    </div>
  {# Chargeback: link to the Software request webform (field_request_form).
     Users who cannot submit (e.g. anonymous) get request_unavailable
     instead: no button, only the link's cache metadata. #}
  {% elseif card_access_type == 'chargeback' %}
    {% if request_link %}
      <div class="software-card__cta-wrap">
        {{ request_link }}
      </div>
    {% elseif request_unavailable %}
      {{ request_unavailable }}
    {% else %}
      <button class="software-card__cta software-card__cta--disabled"
              type="button"
              disabled
              title="Not yet available for request">
        <span class="software-card__cta-icon" aria-hidden="true">+</span>
        Coming soon
      </button>
    {% endif %}
  {% endif %}
</div>
