<?php

/**
 * @file
 * Hook implementations for the LTS Software module.
 */

/**
 * Implements hook_theme().
 */
function lts_software_theme($existing, $type, $theme, $path) {
  return [
    'software_tabs' => [
      'variables' => [
        'tabs' => [],
      ],
      'template' => 'block--software-tabs',
    ],
    // Register the software_library_search catalog view template
    // variants as real theme hooks so they're discovered from THIS module,
    // not the active theme. base hook inherits Views' own variable
    // structure. Same mechanism proven for the commerce_order and
    // paragraph template extractions.
    'views_view__software_library_search__page_1' => [
      'base hook' => 'views_view',
    ],
    'views_view_unformatted__software_library_search__page_1' => [
      'base hook' => 'views_view_unformatted',
    ],
    'views_view_fields__software_library_search__page_1' => [
      'base hook' => 'views_view_fields',
    ],
    // Exposed search form template. base hook views_exposed_form uses
    // render element 'form'. Template file must be named to match the hook:
    // views-exposed-form--software-library-search--page-1.html.twig
    'views_exposed_form__software_library_search__page_1' => [
      'base hook' => 'views_exposed_form',
    ],
  ];
}

/**
 * @file
 * Hook implementations and helper code for the LTS Software module.
 *
 * Provides custom blocks for the software content type detail pages:
 * - SoftwareCtaBlock: conditional CTA per access_type (chargeback/download/redirect)
 * - SoftwareTabsBlock: Description / Terms of Use / System Specs tabs
 *
 * @see \Drupal\lts_software\Plugin\Block\SoftwareCtaBlock
 * @see \Drupal\lts_software\Plugin\Block\SoftwareTabsBlock
 */